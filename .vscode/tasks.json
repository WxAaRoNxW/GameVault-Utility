{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build GVU (PyInstaller, venv)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m", "PyInstaller",
        "--name", "GVU",
        "--contents-directory", "_GVU",
        "main.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}